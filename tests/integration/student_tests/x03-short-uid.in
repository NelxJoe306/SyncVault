# An 8-character prefix of a commit id checks out that commit's file.
I definitions.inc
> init
<<<
+ wug.txt wug.txt
> add wug.txt
<<<
> commit "version 1 of wug.txt"
<<<
+ wug.txt notwug.txt
> add wug.txt
<<<
> commit "version 2 of wug.txt"
<<<
= wug.txt notwug.txt
D HEADER "commit ([a-f0-9]{8})[a-f0-9]+"
> log
===
${HEADER}
${DATE}
version 2 of wug.txt

===
${HEADER}
${DATE}
version 1 of wug.txt

===
${HEADER}
${DATE}
initial commit

<<<*
D UID2 "${1}"
D UID1 "${2}"
> checkout ${UID1} -- wug.txt
<<<
= wug.txt wug.txt
> checkout ${UID2} -- wug.txt
<<<
= wug.txt notwug.txt
