# fetch stores remote/branch as a nested ref, checkout can see it, push appends.
I definitions.inc
C D1
> init
<<<
+ f.txt wug.txt
> add f.txt
<<<
> commit "one"
<<<
> log
===
${COMMIT_HEAD}
one

===
${COMMIT_HEAD}
initial commit

<<<*
D R1_ONE "${1}"
D R1_INIT "${2}"
C D2
> init
<<<
> add-remote R1 ../D1/.gitlet
<<<
> fetch R1 master
<<<
> checkout R1/master
<<<
> log
===
commit ${R1_ONE}
${DATE}
one

===
commit ${R1_INIT}
${DATE}
initial commit

<<<*
> checkout master
<<<
> reset ${R1_ONE}
<<<
+ g.txt notwug.txt
> add g.txt
<<<
> commit "two"
<<<
> log
===
${COMMIT_HEAD}
two

===
commit ${R1_ONE}
${DATE}
one

===
commit ${R1_INIT}
${DATE}
initial commit

<<<*
D R2_TWO "${1}"
> push R1 master
<<<
C D1
> log
===
commit ${R2_TWO}
${DATE}
two

===
commit ${R1_ONE}
${DATE}
one

===
commit ${R1_INIT}
${DATE}
initial commit

<<<*
